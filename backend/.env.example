MCP_SERVER_URL=https://ca-metadata-mcp-dev.wittyforest-26c063ae.eastus.azurecontainerapps.io/mcp
MCP_TIMEOUT_SECONDS=60

# Meta Model API (Step 9). Server-side only -- never commit a real key.
# Verified against Meta docs: OpenAI-compatible API at https://api.meta.ai/v1,
# default model muse-spark-1.3, optional reasoning model muse-wonder-1.0.
MODEL_API_KEY=your_actual_meta_model_api_key
META_MODEL=muse-spark-1.3
META_REASONING_MODEL=muse-wonder-1.0
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_REASONING_EFFORT=low

# Discovery Agent safety limits (optional overrides).
# Verified live 2026-11-01: the MCP server rejects catalog pages > 100 and
# detail lookups > 50 IDs/call, so PAGE_SIZE must stay <= 100; the agent
# pages with offset/next_offset and chunks detail lookups automatically.
DISCOVERY_CATALOG_PAGE_SIZE=100
DISCOVERY_MAX_CATALOG_RECORDS=10000
DISCOVERY_CANDIDATE_LIMIT=30
DISCOVERY_RANK_BATCH_SIZE=10
# Relevance gate: 75-100 direct match, 40-74 supporting context, < 40 weak.
DISCOVERY_MIN_RELEVANCE_SCORE=40
DISCOVERY_PLAN_MAX_COMPLETION_TOKENS=4096
DISCOVERY_RANK_MAX_COMPLETION_TOKENS=8192

# Data Recipe Agent (Step 10, optional override).
RECIPE_MAX_COMPLETION_TOKENS=8192
